[Unit]
Description=extract.dkta.dev — x402 content extraction API
Requires=extract-egress-firewall.service
PartOf=extract-egress-firewall.service
After=network.target extract-egress-firewall.service

[Service]
Type=simple
User=hermes
WorkingDirectory=/opt/extract
Environment=PORT=3721
Environment=NETWORK=base
EnvironmentFile=/opt/extract/.env

# The API still reaches local Crawl4AI, Umami, and the resolver over loopback.
# Target fetches may use only globally routable destinations.
IPAddressDeny=0.0.0.0/8
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=169.254.0.0/16
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.0.0.0/24
IPAddressDeny=192.0.2.0/24
IPAddressDeny=192.168.0.0/16
IPAddressDeny=198.18.0.0/15
IPAddressDeny=198.51.100.0/24
IPAddressDeny=203.0.113.0/24
IPAddressDeny=224.0.0.0/4
IPAddressDeny=240.0.0.0/4
IPAddressDeny=::/128
IPAddressDeny=64:ff9b:1::/48
IPAddressDeny=100::/64
IPAddressDeny=2001::/23
IPAddressDeny=2001:db8::/32
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10
IPAddressDeny=fec0::/10
IPAddressDeny=ff00::/8
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
